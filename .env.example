# API
API_PORT="4000"
API_UPLOADS="./uploads"
API_LOGS="./logs"

# DB
DB_HOST="db"
DB_PORT="5432"
DB_USER="root"
DB_NAME="eznit"

# Web UI
API_SERVE_WEB="true"

# Auth rate limiting — 429 with Retry-After once a limit is hit.
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_WINDOW="15m"
RATE_LIMIT_LOGIN_IP="20"
RATE_LIMIT_LOGIN_EMAIL="10"
RATE_LIMIT_SIGNUP_IP="10"
RATE_LIMIT_SIGNUP_EMAIL="5"
# Trust X-Real-IP / X-Forwarded-For. Only set true when the API is reached only
# through a proxy you control; a direct client can forge the header otherwise.
# Left unset on purpose: the compose product sets it true for the api/dev
# services (the web tier is the entry), and a host `make run_api` defaults false.
# TRUST_PROXY="false"
