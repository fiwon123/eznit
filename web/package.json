{
  "name": "eznit-web",
  "version": "0.1.0",
  "private": true,
  "description": "The web UI for the eznit template catalogue",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
