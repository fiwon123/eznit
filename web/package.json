    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "playwright": "^1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
