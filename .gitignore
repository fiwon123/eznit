# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
.env.local
.env.*
!.env.example
.envrc

# Agent session memory — local to this machine, never committed
.opencode/memory/
.opencode/progress.md

# Dev sandbox marker files — per-checkout state, not source
.dev/

# Python bytecode from the sandbox launcher
__pycache__/
*.pyc

# Editor/IDE
# .idea/
# .vscode/

# project
build/
build/*
.zed/*
secrets/db_password.txt

# project test folders
~ignore/
~ignore/*
downloads/
downloads/*
uploads/
uploads/*
logs/
logs/*
~logs/
~logs/*

# the web UI (web/) — the installed packages and the build output
web/node_modules/
# The build output is ignored, but the folder itself has to exist in the
# repository: `//go:embed all:dist` (web/embed.go) refuses to compile when
# dist is missing, and `make check` and CI compile the Go packages without
# building the web UI. The placeholder is what makes a fresh clone buildable.
web/dist/*
!web/dist/.gitkeep
